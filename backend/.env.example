PORT=5000
NODE_ENV=development
# Leave blank for automated in-memory MongoDB, or provide MongoDB URI:
# MONGODB_URI=mongodb://localhost:27017/ai-job-finder
MONGODB_URI=
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d
# Optional: Provide OpenAI API Key for GPT-4o-mini powered resume analysis (otherwise built-in AI matcher is used)
OPENAI_API_KEY=
# Set to false to disable external Remotive job polling
ENABLE_EXTERNAL_JOB_API=true
