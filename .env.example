# ============================================================
# AI-Powered Job Finder & Career Assistant - Environment Variables
# ============================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Leave blank for zero-setup automated local datastore (persisted at backend/data/store.json)
# Or provide a MongoDB connection string (e.g. MongoDB Atlas or local mongod):
# MONGODB_URI=mongodb://localhost:27017/ai-job-finder
MONGODB_URI=

# JWT Authentication
JWT_SECRET=ai_job_finder_super_secret_jwt_key_2026_production
JWT_EXPIRE=30d

# OpenAI API Key (Optional)
# If provided, GPT-4o-mini is utilized for deeper NLP resume extraction.
# If omitted, the high-speed built-in intelligent heuristic engine handles matching automatically.
OPENAI_API_KEY=

# External Job Integration (Remotive API)
ENABLE_EXTERNAL_JOB_API=true
